{
  "name": "recipes",
  "version": "1.0.0",
  "description": "Calculation of menu",
  "main": "index.js",
  "scripts": {
    "server-start": "gulp",
    "server-watch": "gulp watch",
    "build": "gulp build",
    "build:site": "gulp build:site",
    "image": "gulp img",
    "serve": "node scripts/serve.js",
    "test": "npm run test:static && npm run test:browser && npm run test:apache",
    "test:static": "node --test --test-reporter=spec tests/static/",
    "test:browser": "node --test --test-reporter=spec --test-concurrency=1 tests/browser/",
    "test:apache": "node --test --test-reporter=spec tests/apache/",
    "validate-html": "html-validate \"app/**/*.html\"",
    "sitemap": "gulp sitemap"
  },
  "author": "Polina Shvedko",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "gulp": "^4.0.2",
    "gulp-livereload": "^4.0.2",
    "gulp-webserver": "^0.9.1",
    "html-validate": "^11.16.1",
    "mustache": "^4.2.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5"
  }
}

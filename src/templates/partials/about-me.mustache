{{!
  "About me" section (home and about page): text exactly as on the current site, photo. The heading is shown
  on home only (the about page has its own h1). The heading is upper case through CSS (it read "ABOUT ME").
}}
<section class="about-me" id="about-me"{{#about_me.heading}} aria-labelledby="about-me-heading"{{/about_me.heading}}>
<div class="divider" aria-hidden="true"></div>
{{#about_me.heading}}
<h2 class="about-me__heading" id="about-me-heading">{{t.about_heading}}</h2>
{{/about_me.heading}}
<div class="about-me__row">
<div class="about-me__text">
<p class="about-me__name">{{t.about_name1}}</p>
<p class="about-me__name">{{t.about_name2}}</p>
<p class="about-me__descr">{{t.about_descr}}</p>
</div>
<div class="about-me__media">
{{#about_me.photo}}{{> picture}}{{/about_me.photo}}
</div>
</div>
</section>

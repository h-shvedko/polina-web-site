# Line endings: LF in the repository and in every working tree, also when core.autocrlf is true, so a local
# build gives the same bytes (and the same ?v= content hashes) as CI. Binary files are never converted.
* text=auto eol=lf
*.[jJ][pP][gG] binary
*.[jJ][pP][eE][gG] binary
*.[pP][nN][gG] binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
*.woff2 binary
# Videos go to Git LFS (the owner's original rule; no video is tracked today). After the text rule, so *.mp4 is
# never treated as text.
*.mp4 filter=lfs diff=lfs merge=lfs -text
